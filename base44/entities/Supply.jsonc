{
  "name": "Supply",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sector": {
      "type": "string",
      "enum": [
        "materia_prima",
        "venta_directa",
        "utensilio"
      ],
      "default": "materia_prima"
    },
    "category": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "g",
        "ml",
        "unidad"
      ]
    },
    "stock_current": {
      "type": "number"
    },
    "stock_warehouse": {
      "type": "number",
      "default": 0
    },
    "stock_production": {
      "type": "number",
      "default": 0
    },
    "stock_minimum": {
      "type": "number"
    },
    "cost_per_unit": {
      "type": "number"
    },
    "supplier": {
      "type": "string"
    },
    "is_infinite": {
      "type": "boolean",
      "default": false
    },
    "package_format": {
      "type": "object",
      "properties": {
        "presentation": {
          "type": "string"
        },
        "net_content": {
          "type": "number"
        },
        "package_unit": {
          "type": "string"
        },
        "purchase_price": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "name",
    "unit"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}