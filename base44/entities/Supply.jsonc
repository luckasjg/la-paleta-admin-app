{
  "name": "Supply",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "sector": {
      "type": "string",
      "enum": [
        "materia_prima",
        "venta_directa",
        "utensilio"
      ],
      "default": "materia_prima"
    },
    "category": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "g",
        "ml",
        "unidad"
      ]
    },
    "stock_current": {
      "type": "number"
    },
    "stock_warehouse": {
      "type": "number",
      "default": 0
    },
    "stock_production": {
      "type": "number",
      "default": 0
    },
    "stock_minimum": {
      "type": "number"
    },
    "cost_per_unit": {
      "type": "number"
    },
    "supplier": {
      "type": "string"
    },
    "is_infinite": {
      "type": "boolean",
      "default": false
    },
    "residual_threshold": {
      "type": "number",
      "description": "Umbral m\u00ednimo utilizable. Por defecto 20 en g/ml y 0 en unidades o microdosificaci\u00f3n"
    },
    "ignore_overstock_alert": {
      "type": "boolean",
      "default": false,
      "description": "Silencia alertas de inactividad / sobreexistencia del Auditor"
    },
    "low_stock_alerted": {
      "type": "boolean",
      "default": false,
      "description": "true si ya se notific\u00f3 por Slack que este insumo est\u00e1 bajo el m\u00ednimo"
    },
    "low_stock_alerted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que se envi\u00f3 alerta de stock bajo por Slack"
    },
    "package_type": {
      "type": "string",
      "description": "Tipo de empaque del utensilio (Paquete, Caja, Bolsa)"
    },
    "units_per_package": {
      "type": "number",
      "description": "Unidades base que trae 1 empaque"
    },
    "package_format": {
      "type": "object",
      "properties": {
        "presentation": {
          "type": "string"
        },
        "net_content": {
          "type": "number"
        },
        "package_unit": {
          "type": "string"
        },
        "purchase_price": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "name",
    "unit"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}