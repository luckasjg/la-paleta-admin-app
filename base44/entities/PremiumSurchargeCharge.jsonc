{
  "name": "PremiumSurchargeCharge",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "Venta original despachada"
    },
    "ticket_number": {
      "type": "number"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_cedula": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "flavors_detail": {
      "type": "string",
      "description": "Sabores premium servidos"
    },
    "amount_usd": {
      "type": "number",
      "description": "Diferencia a cobrar (USD base)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "cobrado",
        "anulado"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "pendiente"
    },
    "origin_cash_register_id": {
      "type": "string"
    },
    "dispatched_by": {
      "type": "string"
    },
    "paid_sale_id": {
      "type": "string",
      "description": "Venta de recargo con la que se cobr\u00f3"
    },
    "paid_cash_register_id": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    }
  },
  "required": [
    "sale_id",
    "amount_usd",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}