{
  "name": "InventoryTransfer",
  "type": "object",
  "properties": {
    "supply_id": {
      "type": "string"
    },
    "supply_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "from_location": {
      "type": "string",
      "enum": [
        "warehouse",
        "production"
      ],
      "default": "warehouse"
    },
    "to_location": {
      "type": "string",
      "enum": [
        "warehouse",
        "production"
      ],
      "default": "production"
    },
    "notes": {
      "type": "string"
    },
    "transfer_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "supply_id",
    "quantity"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}