{
  "name": "StaffPOS",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nombre del empleado que opera el POS"
    },
    "pin": {
      "type": "string",
      "description": "PIN num\u00e9rico de 4-6 d\u00edgitos para abrir caja"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "pin"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}