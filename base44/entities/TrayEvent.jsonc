{
  "name": "TrayEvent",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "nueva",
        "relleno",
        "transferencia"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "tray_id": {
      "type": "string",
      "description": "Bandeja producida/rellenada o destino de la transferencia"
    },
    "recipe_name": {
      "type": "string"
    },
    "grams": {
      "type": "number",
      "description": "Gramos producidos o transferidos"
    },
    "remaining_before": {
      "type": "number"
    },
    "remaining_after": {
      "type": "number"
    },
    "source_tray_id": {
      "type": "string"
    },
    "source_recipe_name": {
      "type": "string"
    },
    "master_batch_id": {
      "type": "string",
      "description": "Lote maestro de origen, si aplica"
    },
    "master_base_name": {
      "type": "string"
    },
    "independent_batch_id": {
      "type": "string",
      "description": "Lote independiente agrupado de origen, si aplica"
    },
    "operator": {
      "type": "string"
    },
    "production_ref": {
      "type": "string",
      "description": "Referencia de los movimientos de inventario de esta producci\u00f3n"
    },
    "inventory_bypass": {
      "type": "boolean",
      "default": false,
      "description": "Carga inicial sin descuento de materia prima"
    }
  },
  "required": [
    "type",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}