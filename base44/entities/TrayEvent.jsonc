{
  "name": "TrayEvent",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "nueva",
        "relleno",
        "transferencia"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "tray_id": {
      "type": "string",
      "description": "Bandeja producida/rellenada o destino de la transferencia"
    },
    "recipe_name": {
      "type": "string"
    },
    "grams": {
      "type": "number",
      "description": "Gramos producidos o transferidos"
    },
    "remaining_before": {
      "type": "number"
    },
    "remaining_after": {
      "type": "number"
    },
    "source_tray_id": {
      "type": "string"
    },
    "source_recipe_name": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "date"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}