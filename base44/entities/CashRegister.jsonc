{
  "name": "CashRegister",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "system_cash": {
      "type": "number"
    },
    "system_digital": {
      "type": "number"
    },
    "declared_cash": {
      "type": "number"
    },
    "difference": {
      "type": "number"
    },
    "total_sales": {
      "type": "number"
    },
    "sales_count": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "abierta",
        "cerrada"
      ]
    },
    "operator": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "shift",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}