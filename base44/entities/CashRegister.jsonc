{
  "name": "CashRegister",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "opening_cash_usd": {
      "type": "number",
      "default": 0,
      "description": "Fondo de caja inicial en divisas (EUR/USD f\u00edsico), s\u00f3lo para reconciliaci\u00f3n"
    },
    "opening_cash_ves": {
      "type": "number",
      "default": 0,
      "description": "Fondo de caja inicial en bol\u00edvares, s\u00f3lo para reconciliaci\u00f3n"
    },
    "cash_change_usd": {
      "type": "number",
      "description": "Vueltos entregados en efectivo durante la sesi\u00f3n (USD base)"
    },
    "system_cash": {
      "type": "number",
      "description": "Efectivo esperado total combinado (USD base)"
    },
    "system_digital": {
      "type": "number"
    },
    "declared_cash": {
      "type": "number",
      "description": "Efectivo declarado total combinado (USD base)"
    },
    "difference": {
      "type": "number",
      "description": "Diferencia total combinada (USD base)"
    },
    "system_cash_usd": {
      "type": "number",
      "description": "Efectivo USD f\u00edsico esperado"
    },
    "system_cash_ves": {
      "type": "number",
      "description": "Efectivo Bs f\u00edsico esperado (Bs)"
    },
    "declared_cash_usd": {
      "type": "number"
    },
    "declared_cash_ves": {
      "type": "number",
      "description": "Bs contados"
    },
    "difference_usd": {
      "type": "number"
    },
    "difference_ves": {
      "type": "number",
      "description": "Diferencia en Bs"
    },
    "digital_usd": {
      "type": "number",
      "description": "Ingresos digitales en USD (Binance, Zelle\u2026)"
    },
    "digital_ves": {
      "type": "number",
      "description": "Ingresos digitales en Bs (pago m\u00f3vil, punto\u2026)"
    },
    "total_sales": {
      "type": "number",
      "description": "Ventas cobradas (excluye ventas a cr\u00e9dito)"
    },
    "sales_count": {
      "type": "number"
    },
    "credit_sales_usd": {
      "type": "number",
      "default": 0,
      "description": "Monto de ventas a cr\u00e9dito (pendientes de cobro) en la sesi\u00f3n"
    },
    "credit_sales_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de ventas a cr\u00e9dito en la sesi\u00f3n"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "abierta",
        "cerrada"
      ]
    },
    "operator": {
      "type": "string"
    },
    "staff_id": {
      "type": "string",
      "description": "ID del StaffPOS que abri\u00f3 la sesi\u00f3n"
    },
    "staff_name": {
      "type": "string",
      "description": "Nombre del empleado que abri\u00f3 la sesi\u00f3n"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "date",
    "shift",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}