{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "wallet_id": {
      "type": "string"
    },
    "wallet_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "sale_income",
        "change_given",
        "conversion_out",
        "conversion_in",
        "manual_adjust",
        "initial_balance"
      ]
    },
    "amount_native": {
      "type": "number"
    },
    "amount_usd_equivalent": {
      "type": "number"
    },
    "exchange_rate": {
      "type": "number"
    },
    "sale_id": {
      "type": "string"
    },
    "linked_transaction_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wallet_id",
    "type",
    "amount_native"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}