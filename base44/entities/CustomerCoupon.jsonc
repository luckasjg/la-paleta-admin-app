{
  "name": "CustomerCoupon",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Nombre del bono, ej. Cup\u00f3n de bienvenida"
    },
    "benefit": {
      "type": "string",
      "description": "Beneficio concreto que recibe el cliente, ej. 1 helado peque\u00f1o gratis"
    },
    "description": {
      "type": "string",
      "description": "Condiciones o c\u00f3mo usarlo"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "canjeado",
        "anulado"
      ],
      "default": "activo"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "redeemed_by": {
      "type": "string"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_by": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}