{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "description": "Identificador \u00fanico interno del m\u00e9todo (ej. efectivo_usd, pago_movil_banesco). Slug en min\u00fasculas con guiones bajos."
    },
    "label": {
      "type": "string",
      "description": "Nombre visible del m\u00e9todo (ej. Pago M\u00f3vil Banesco, Punto de Venta 2)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "VES"
      ],
      "description": "Moneda nativa del m\u00e9todo"
    },
    "icon": {
      "type": "string",
      "enum": [
        "DollarSign",
        "Banknote",
        "Smartphone",
        "CreditCard",
        "Send",
        "Wallet",
        "Building2",
        "Landmark"
      ],
      "default": "CreditCard",
      "description": "Nombre del icono lucide-react"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si el m\u00e9todo est\u00e1 disponible para nuevas ventas"
    },
    "sort_order": {
      "type": "number",
      "default": 99,
      "description": "Orden de visualizaci\u00f3n en el POS"
    },
    "is_legacy": {
      "type": "boolean",
      "default": false,
      "description": "Marca los 5 m\u00e9todos originales del sistema (no se pueden eliminar para preservar hist\u00f3rico)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "value",
    "label",
    "currency"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}