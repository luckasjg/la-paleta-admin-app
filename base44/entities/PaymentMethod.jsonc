{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "value": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "VES"
      ]
    },
    "icon": {
      "type": "string",
      "enum": [
        "DollarSign",
        "Banknote",
        "Smartphone",
        "CreditCard",
        "Send",
        "Wallet",
        "Building2",
        "Landmark"
      ],
      "default": "CreditCard"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 99
    },
    "is_legacy": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "value",
    "label",
    "currency"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}