{
  "name": "IceCreamAudit",
  "type": "object",
  "properties": {
    "audit_date": {
      "type": "string",
      "format": "date"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "cash_register_id": {
      "type": "string",
      "description": "Sesi\u00f3n de caja auditada. Permite auditor\u00edas tard\u00edas correlacionadas al turno."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tray_id": {
            "type": "string"
          },
          "recipe_name": {
            "type": "string"
          },
          "initial_grams": {
            "type": "number"
          },
          "grams_sold_theoretical": {
            "type": "number"
          },
          "theoretical_stock": {
            "type": "number"
          },
          "physical_weight": {
            "type": "number"
          },
          "variance": {
            "type": "number"
          },
          "cost_per_gram": {
            "type": "number"
          },
          "financial_impact": {
            "type": "number"
          }
        }
      }
    },
    "total_variance_grams": {
      "type": "number"
    },
    "financial_impact": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "audit_date"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}