{
  "name": "InventoryAdjustment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "supply",
        "tray",
        "production_consumption",
        "sale_cancellation"
      ]
    },
    "reference_id": {
      "type": "string"
    },
    "reference_name": {
      "type": "string"
    },
    "quantity_change": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "description": "Motivo del ajuste (value de AdjustmentReason)"
    },
    "notes": {
      "type": "string"
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "original_quantity_change": {
      "type": "number"
    },
    "supply_id": {
      "type": "string"
    },
    "supply_name": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "enum": [
        "production",
        "warehouse"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "helados",
        "preparados"
      ],
      "description": "Origen del consumo de producci\u00f3n"
    },
    "stock_before": {
      "type": "number"
    },
    "stock_after": {
      "type": "number"
    },
    "reference_label": {
      "type": "string",
      "description": "Origen legible: Bandeja, Relleno, Lote Maestro, Preparado, Anulaci\u00f3n de venta"
    },
    "unit_cost": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "is_correction": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "type",
    "reference_id",
    "reason"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}