{
  "name": "InventoryAdjustment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "supply",
        "tray"
      ],
      "description": "Tipo de ajuste"
    },
    "reference_id": {
      "type": "string",
      "description": "ID del insumo o bandeja"
    },
    "reference_name": {
      "type": "string",
      "description": "Nombre del insumo o bandeja"
    },
    "quantity_change": {
      "type": "number",
      "description": "Cambio en cantidad (positivo = agregar, negativo = restar)"
    },
    "reason": {
      "type": "string",
      "enum": [
        "derrame",
        "producto_da\u00f1ado",
        "conteo_fisico",
        "devolucion",
        "otro"
      ],
      "description": "Motivo del ajuste"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "type",
    "reference_id",
    "reason"
  ]
}