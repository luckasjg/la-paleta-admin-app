{
  "name": "InventoryAdjustment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "supply",
        "tray"
      ]
    },
    "reference_id": {
      "type": "string"
    },
    "reference_name": {
      "type": "string"
    },
    "quantity_change": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "enum": [
        "derrame",
        "producto_da\u00f1ado",
        "conteo_fisico",
        "devolucion",
        "otro"
      ]
    },
    "notes": {
      "type": "string"
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "original_quantity_change": {
      "type": "number"
    }
  },
  "required": [
    "type",
    "reference_id",
    "reason"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}