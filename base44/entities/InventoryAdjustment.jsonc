{
  "name": "InventoryAdjustment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "supply",
        "tray"
      ],
      "description": "Tipo de ajuste"
    },
    "reference_id": {
      "type": "string",
      "description": "ID del insumo o bandeja"
    },
    "reference_name": {
      "type": "string",
      "description": "Nombre del insumo o bandeja"
    },
    "quantity_change": {
      "type": "number",
      "description": "Cambio en cantidad (positivo = agregar, negativo = restar)"
    },
    "reason": {
      "type": "string",
      "enum": [
        "derrame",
        "producto_da\u00f1ado",
        "conteo_fisico",
        "devolucion",
        "otro"
      ],
      "description": "Motivo del ajuste"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "is_edited": {
      "type": "boolean",
      "description": "Indica si el ajuste fue editado posteriormente",
      "default": false
    },
    "original_quantity_change": {
      "type": "number",
      "description": "Valor original antes de la \u00faltima edici\u00f3n"
    }
  },
  "required": [
    "type",
    "reference_id",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}