{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "recipe_number": {
      "type": "number",
      "description": "N\u00famero de receta"
    },
    "name": {
      "type": "string",
      "description": "Nombre del sabor/producto"
    },
    "type": {
      "type": "string",
      "enum": [
        "helado",
        "cafe",
        "merengada",
        "otro"
      ],
      "description": "Tipo de receta"
    },
    "yield_amount": {
      "type": "number",
      "description": "Mix deseado en gramos"
    },
    "yield_unit": {
      "type": "string",
      "enum": [
        "ml",
        "unidad"
      ],
      "description": "Unidad de rendimiento"
    },
    "overrun": {
      "type": "number",
      "description": "Overrun en % (expansi\u00f3n del helado)"
    },
    "service_temperature": {
      "type": "number",
      "description": "Temperatura de servicio en \u00b0C"
    },
    "ingredients": {
      "type": "array",
      "description": "Ingredientes con datos t\u00e9cnicos",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string"
          },
          "supply_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad en gramos"
          },
          "unit": {
            "type": "string"
          },
          "percentage": {
            "type": "number",
            "description": "% sobre el total del mix"
          },
          "sugars": {
            "type": "number",
            "description": "Az\u00facares en g"
          },
          "fats": {
            "type": "number",
            "description": "Grasas en g"
          },
          "slngo": {
            "type": "number",
            "description": "S.L.N.G.O. en g (s\u00f3lidos l\u00e1cteos no grasos)"
          },
          "other_solids": {
            "type": "number",
            "description": "Otros s\u00f3lidos en g"
          },
          "calories": {
            "type": "number",
            "description": "Calor\u00edas"
          }
        }
      }
    },
    "image_url": {
      "type": "string",
      "description": "Foto del producto"
    },
    "sale_price": {
      "type": "number",
      "description": "Precio de venta sugerido"
    },
    "is_active": {
      "type": "boolean",
      "description": "Si la receta est\u00e1 activa"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "name",
    "type"
  ]
}