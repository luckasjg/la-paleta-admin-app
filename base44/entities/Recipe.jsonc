{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "helado",
        "cafe",
        "merengada",
        "otro"
      ]
    },
    "yield_amount": {
      "type": "number"
    },
    "yield_unit": {
      "type": "string",
      "enum": [
        "ml",
        "unidad"
      ]
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string"
          },
          "supply_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "image_url": {
      "type": "string"
    },
    "sale_price": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean"
    },
    "flavor_tag": {
      "type": "string",
      "enum": [
        "Regular",
        "Premium",
        "Sorbete"
      ],
      "default": "Regular"
    },
    "ref_surcharge_amount": {
      "type": "number",
      "default": 0
    },
    "ref_surcharge_grams": {
      "type": "number",
      "default": 0
    },
    "surcharge_per_gram": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}