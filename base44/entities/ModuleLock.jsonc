{
  "name": "ModuleLock",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "M\u00f3dulo protegido, ej. recetas"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash PBKDF2 con sal de la clave (o SHA-256 legado)"
    },
    "password_salt": {
      "type": "string",
      "description": "Sal aleatoria del hash PBKDF2"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "module"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}