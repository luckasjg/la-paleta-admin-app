{
  "name": "WalletConsolidation",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del cierre/consolidaci\u00f3n"
    },
    "wallet_id": {
      "type": "string",
      "description": "ID de la billetera de origen"
    },
    "wallet_name": {
      "type": "string",
      "description": "Snapshot del nombre de la billetera"
    },
    "wallet_currency": {
      "type": "string",
      "enum": [
        "USD",
        "VES"
      ],
      "description": "Moneda nativa de la billetera"
    },
    "amount_native": {
      "type": "number",
      "description": "Monto exacto consolidado en la moneda nativa de la billetera"
    },
    "amount_ves": {
      "type": "number",
      "default": 0,
      "description": "Equivalente en VES al momento del cierre (0 si la billetera es USD y no aplica)"
    },
    "amount_usd": {
      "type": "number",
      "default": 0,
      "description": "Equivalente en USD al momento del cierre"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Tasa USD\u2192VES vigente al momento del cierre"
    },
    "destination": {
      "type": "string",
      "description": "Destino f\u00edsico del fondo (ej. Transferido a Cuenta Bancaria, Caja Fuerte Principal, Liquidado por Cierre de Turno)"
    },
    "source": {
      "type": "string",
      "enum": [
        "cash_register_close",
        "manual"
      ],
      "default": "manual",
      "description": "Origen de la consolidaci\u00f3n: cierre autom\u00e1tico de caja o ajuste manual"
    },
    "cash_register_id": {
      "type": "string",
      "description": "Si proviene de un cierre de caja, ID del CashRegister relacionado"
    },
    "closed_by": {
      "type": "string",
      "description": "Email o nombre del usuario que ejecut\u00f3 el cierre"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones adicionales"
    }
  },
  "required": [
    "wallet_id",
    "amount_native",
    "destination"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}