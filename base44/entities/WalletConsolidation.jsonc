{
  "name": "WalletConsolidation",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "wallet_id": {
      "type": "string"
    },
    "wallet_name": {
      "type": "string"
    },
    "wallet_currency": {
      "type": "string",
      "enum": [
        "USD",
        "VES"
      ]
    },
    "amount_native": {
      "type": "number"
    },
    "amount_ves": {
      "type": "number",
      "default": 0
    },
    "amount_usd": {
      "type": "number",
      "default": 0
    },
    "exchange_rate": {
      "type": "number"
    },
    "destination": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "cash_register_close",
        "manual"
      ],
      "default": "manual"
    },
    "cash_register_id": {
      "type": "string"
    },
    "closed_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "wallet_id",
    "amount_native",
    "destination"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}