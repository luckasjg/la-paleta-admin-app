{
  "name": "Sale",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "recipe_id": {
            "type": "string"
          },
          "utensil_supply_id": {
            "type": "string"
          },
          "linked_supplies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "supply_id": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "flavor": {
            "type": "string"
          },
          "flavors": {
            "type": "array",
            "description": "Desglose por bandeja: cada sabor elegido con sus gramos. Es la fuente de verdad para descontar y reponer inventario.",
            "items": {
              "type": "object",
              "properties": {
                "tray_id": {
                  "type": "string"
                },
                "recipe_name": {
                  "type": "string"
                },
                "grams": {
                  "type": "number"
                }
              }
            }
          },
          "tray_id": {
            "type": "string"
          },
          "grams": {
            "type": "number"
          },
          "vessel": {
            "type": "string"
          },
          "is_courtesy": {
            "type": "boolean"
          },
          "quantity": {
            "type": "number"
          },
          "base_price": {
            "type": "number"
          },
          "flavor_surcharge": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "unit_price_eur": {
            "type": "number",
            "description": "Precio unitario cobrado en EUR (precio base USD \u00d7 cross USD\u2192EUR)"
          },
          "subtotal_eur": {
            "type": "number",
            "description": "Subtotal cobrado en EUR"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Total en USD (base contable)"
    },
    "total_eur": {
      "type": "number",
      "description": "Total efectivamente cobrado al cliente en EUR"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Tasa USD\u2194VES vigente en la venta"
    },
    "exchange_rate_eur_ves": {
      "type": "number",
      "description": "Tasa EUR\u2194VES vigente en la venta"
    },
    "exchange_rate_usd_eur": {
      "type": "number",
      "description": "Cross usada: cu\u00e1ntos EUR equivale 1 USD base"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "amount_eur": {
            "type": "number"
          },
          "amount_ves": {
            "type": "number"
          },
          "amount_usd_equivalent": {
            "type": "number"
          }
        }
      }
    },
    "payment_method": {
      "type": "string"
    },
    "cash_amount": {
      "type": "number"
    },
    "digital_amount": {
      "type": "number"
    },
    "change_amount": {
      "type": "number",
      "description": "Monto del vuelto entregado, en la moneda de change_currency"
    },
    "change_currency": {
      "type": "string",
      "enum": [
        "USD",
        "VES",
        "EUR"
      ],
      "description": "Moneda en la que se entreg\u00f3 el vuelto"
    },
    "change_amount_usd_equivalent": {
      "type": "number",
      "description": "Equivalente en USD del vuelto entregado"
    },
    "change_wallet_id": {
      "type": "string",
      "description": "Billetera desde la que sali\u00f3 el dinero del vuelto"
    },
    "change_wallet_name": {
      "type": "string"
    },
    "change_method": {
      "type": "string",
      "enum": [
        "efectivo",
        "pago_movil",
        "transferencia"
      ],
      "default": "efectivo",
      "description": "V\u00eda por la que se entreg\u00f3/devolver\u00e1 el vuelto"
    },
    "change_customer_data": {
      "type": "object",
      "description": "Datos bancarios del cliente cuando el vuelto se devuelve por pago m\u00f3vil/transferencia",
      "properties": {
        "titular": {
          "type": "string"
        },
        "cedula": {
          "type": "string"
        },
        "banco": {
          "type": "string"
        },
        "tipo_cuenta": {
          "type": "string"
        },
        "numero_cuenta": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        }
      }
    },
    "change_reference": {
      "type": "string",
      "description": "Motivo / referencia de la devoluci\u00f3n"
    },
    "change_refund_request_id": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "voided"
      ],
      "default": "completed"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_by": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "cash_register_id": {
      "type": "string",
      "description": "ID de la sesi\u00f3n de caja activa al momento de la venta"
    },
    "staff_id": {
      "type": "string",
      "description": "ID del empleado que realiz\u00f3 la venta"
    },
    "staff_name": {
      "type": "string",
      "description": "Nombre del empleado que realiz\u00f3 la venta"
    }
  },
  "required": [
    "total"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}