{
  "name": "Sale",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "recipe_id": {
            "type": "string"
          },
          "utensil_supply_id": {
            "type": "string"
          },
          "linked_supplies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "supply_id": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "flavor": {
            "type": "string"
          },
          "flavors": {
            "type": "array",
            "description": "Desglose por bandeja: cada sabor elegido con sus gramos. Es la fuente de verdad para descontar y reponer inventario.",
            "items": {
              "type": "object",
              "properties": {
                "tray_id": {
                  "type": "string"
                },
                "recipe_name": {
                  "type": "string"
                },
                "grams": {
                  "type": "number"
                }
              }
            }
          },
          "unit_flavors": {
            "type": "array",
            "description": "Sabores por unidad f\u00edsica (longitud = quantity); cada posici\u00f3n es la lista de sabores de esa unidad. Vac\u00eda = se elige en Despacho",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tray_id": {
                    "type": "string"
                  },
                  "recipe_name": {
                    "type": "string"
                  },
                  "grams": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "unit_surcharges": {
            "type": "array",
            "description": "Recargo premium cobrado en caja por cada unidad (USD base)",
            "items": {
              "type": "number"
            }
          },
          "included_toppings_count": {
            "type": "number",
            "description": "Toppings incluidos por unidad"
          },
          "allowed_topping_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unit_toppings": {
            "type": "array",
            "description": "Toppings por unidad (incluidos y extras)",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string"
                  },
                  "product_name": {
                    "type": "string"
                  },
                  "list_price": {
                    "type": "number"
                  },
                  "price": {
                    "type": "number"
                  },
                  "included": {
                    "type": "boolean"
                  },
                  "none": {
                    "type": "boolean"
                  },
                  "deducted": {
                    "type": "boolean"
                  },
                  "deducted_location": {
                    "type": "string",
                    "description": "Ubicaci\u00f3n de la que se descontaron sus insumos"
                  },
                  "deducted_supplies": {
                    "type": "array",
                    "description": "Insumos descontados por este topping",
                    "items": {
                      "type": "object",
                      "properties": {
                        "supply_id": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "unit_topping_extras": {
            "type": "array",
            "description": "Monto cobrado por toppings extra en cada unidad (USD base)",
            "items": {
              "type": "number"
            }
          },
          "pending_toppings": {
            "type": "boolean",
            "description": "Quedan cupos de toppings incluidos por elegir en Despacho"
          },
          "pending_included_toppings": {
            "type": "number"
          },
          "toppings_cost": {
            "type": "number",
            "description": "Costo real de los toppings descontados (COGS)"
          },
          "promo_discount": {
            "type": "number",
            "description": "Descuento promocional aplicado al \u00edtem (USD base)"
          },
          "promo_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subtotal_before_promo": {
            "type": "number"
          },
          "tray_id": {
            "type": "string"
          },
          "grams": {
            "type": "number"
          },
          "vessel": {
            "type": "string"
          },
          "is_courtesy": {
            "type": "boolean"
          },
          "pending_dispatch": {
            "type": "boolean",
            "description": "Helado pendiente de servir en vitrina (los gramos se descuentan al despachar)"
          },
          "staff_discount": {
            "type": "boolean",
            "description": "Excedente del bono cobrado con descuento de colaborador"
          },
          "bonus_free_qty": {
            "type": "number",
            "description": "Unidades cubiertas por el bono semanal del colaborador"
          },
          "quantity": {
            "type": "number"
          },
          "base_price": {
            "type": "number"
          },
          "flavor_surcharge": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "unit_price_eur": {
            "type": "number",
            "description": "Precio unitario cobrado en EUR (precio base USD \u00d7 cross USD\u2192EUR)"
          },
          "subtotal_eur": {
            "type": "number",
            "description": "Subtotal cobrado en EUR"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Total en USD (base contable), neto de promociones"
    },
    "discount_amount": {
      "type": "number",
      "description": "Descuento promocional total (USD base)"
    },
    "applied_promotions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "promotion_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "total_eur": {
      "type": "number",
      "description": "Total efectivamente cobrado al cliente en EUR"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Tasa USD\u2194VES vigente en la venta"
    },
    "exchange_rate_eur_ves": {
      "type": "number",
      "description": "Tasa EUR\u2194VES vigente en la venta"
    },
    "exchange_rate_usd_eur": {
      "type": "number",
      "description": "Cross usada: cu\u00e1ntos EUR equivale 1 USD base"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "amount_eur": {
            "type": "number"
          },
          "amount_ves": {
            "type": "number"
          },
          "amount_usd_equivalent": {
            "type": "number"
          }
        }
      }
    },
    "payment_method": {
      "type": "string"
    },
    "cash_amount": {
      "type": "number"
    },
    "digital_amount": {
      "type": "number"
    },
    "change_amount": {
      "type": "number",
      "description": "Monto del vuelto entregado, en la moneda de change_currency (agregado de change_breakdown)"
    },
    "change_currency": {
      "type": "string",
      "enum": [
        "USD",
        "VES",
        "EUR"
      ],
      "description": "Moneda en la que se entreg\u00f3 el vuelto"
    },
    "change_amount_usd_equivalent": {
      "type": "number",
      "description": "Equivalente en USD del vuelto entregado (suma de todos los tramos)"
    },
    "change_wallet_id": {
      "type": "string",
      "description": "Billetera desde la que sali\u00f3 el dinero del vuelto"
    },
    "change_wallet_name": {
      "type": "string"
    },
    "change_method": {
      "type": "string",
      "enum": [
        "efectivo",
        "pago_movil",
        "transferencia"
      ],
      "default": "efectivo",
      "description": "V\u00eda por la que se entreg\u00f3/devolver\u00e1 el vuelto"
    },
    "change_customer_data": {
      "type": "object",
      "description": "Datos bancarios del cliente cuando el vuelto se devuelve por pago m\u00f3vil/transferencia",
      "properties": {
        "titular": {
          "type": "string"
        },
        "cedula": {
          "type": "string"
        },
        "banco": {
          "type": "string"
        },
        "tipo_cuenta": {
          "type": "string"
        },
        "numero_cuenta": {
          "type": "string"
        },
        "telefono": {
          "type": "string"
        }
      }
    },
    "change_reference": {
      "type": "string",
      "description": "Motivo / referencia de la devoluci\u00f3n"
    },
    "change_refund_request_id": {
      "type": "string"
    },
    "change_breakdown": {
      "type": "array",
      "description": "Tramos del vuelto: cada uno con su m\u00e9todo, moneda y billetera de salida",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "amount_native": {
            "type": "number"
          },
          "amount_usd_equivalent": {
            "type": "number"
          },
          "wallet_id": {
            "type": "string"
          },
          "wallet_name": {
            "type": "string"
          },
          "customer_data": {
            "type": "object"
          },
          "reference": {
            "type": "string"
          },
          "refund_request_id": {
            "type": "string"
          }
        }
      }
    },
    "sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "voided"
      ],
      "default": "completed"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_by": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "void_inventory_restored": {
      "type": "boolean",
      "description": "Si al anular se reintegraron insumos y toppings al inventario"
    },
    "cash_register_id": {
      "type": "string",
      "description": "ID de la sesi\u00f3n de caja activa al momento de la venta"
    },
    "staff_id": {
      "type": "string",
      "description": "ID del empleado que realiz\u00f3 la venta"
    },
    "staff_name": {
      "type": "string",
      "description": "Nombre del empleado que realiz\u00f3 la venta"
    },
    "benefit_staff_id": {
      "type": "string",
      "description": "Colaborador (StaffPOS) beneficiario del bono en esta venta"
    },
    "benefit_staff_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente identificado en el POS (por c\u00e9dula)"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_cedula": {
      "type": "string"
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "pendiente",
        "despachado"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "despachado"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que Despacho complet\u00f3 la orden (solo ventas con despacho diferido)"
    },
    "ticket_number": {
      "type": "number",
      "description": "Correlativo de la venta dentro del turno (sesi\u00f3n de caja)"
    }
  },
  "required": [
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}