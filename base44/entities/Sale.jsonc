{
  "name": "Sale",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "flavor": {
            "type": "string"
          },
          "tray_id": {
            "type": "string"
          },
          "grams": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number"
    },
    "exchange_rate": {
      "type": "number"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "amount_ves": {
            "type": "number"
          },
          "amount_usd_equivalent": {
            "type": "number"
          }
        }
      }
    },
    "payment_method": {
      "type": "string"
    },
    "cash_amount": {
      "type": "number"
    },
    "digital_amount": {
      "type": "number"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "voided"
      ],
      "default": "completed"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time"
    },
    "voided_by": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "cash_register_id": {
      "type": "string",
      "description": "ID de la sesi\u00f3n de caja activa al momento de la venta"
    },
    "staff_id": {
      "type": "string",
      "description": "ID del empleado que realiz\u00f3 la venta"
    },
    "staff_name": {
      "type": "string",
      "description": "Nombre del empleado que realiz\u00f3 la venta"
    }
  },
  "required": [
    "total"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}