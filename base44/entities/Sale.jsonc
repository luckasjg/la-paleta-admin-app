{
  "name": "Sale",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "description": "\u00cdtems vendidos",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "flavor": {
            "type": "string"
          },
          "tray_id": {
            "type": "string"
          },
          "grams": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Total de la venta en USD"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Tasa de cambio USD\u2192VES vigente en el momento de la venta"
    },
    "payments": {
      "type": "array",
      "description": "Desglose de pagos mixtos",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "efectivo_usd",
              "efectivo_ves",
              "pago_movil",
              "punto_venta",
              "zelle"
            ]
          },
          "amount_usd": {
            "type": "number",
            "description": "Monto si el cobro fue en USD"
          },
          "amount_ves": {
            "type": "number",
            "description": "Monto si el cobro fue en VES"
          },
          "amount_usd_equivalent": {
            "type": "number",
            "description": "Equivalente en USD para totalizaci\u00f3n"
          }
        }
      }
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "efectivo",
        "pago_movil",
        "punto_venta",
        "mixto",
        "efectivo_usd",
        "efectivo_ves",
        "zelle"
      ],
      "description": "M\u00e9todo de pago resumen (legacy/compatibilidad)"
    },
    "cash_amount": {
      "type": "number",
      "description": "Monto total en efectivo (USD equivalente, legacy)"
    },
    "digital_amount": {
      "type": "number",
      "description": "Monto total digital (USD equivalente, legacy)"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la venta"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ],
      "description": "Turno"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "voided"
      ],
      "default": "completed",
      "description": "Estado de la venta. 'voided' indica que fue anulada y el inventario fue restituido."
    },
    "voided_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que se anul\u00f3 la venta"
    },
    "voided_by": {
      "type": "string",
      "description": "Email del administrador que anul\u00f3 la venta"
    },
    "void_reason": {
      "type": "string",
      "description": "Motivo de la anulaci\u00f3n"
    }
  },
  "required": [
    "total"
  ]
}