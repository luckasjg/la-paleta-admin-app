{
  "name": "LoyaltyRedemption",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "description": "Nivel de fidelidad canjeado"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "staff_name": {
      "type": "string"
    },
    "cash_register_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "level"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}