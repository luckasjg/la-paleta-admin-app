{
  "name": "Customer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto (identificador para volver a entrar)"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n para delivery"
    },
    "email": {
      "type": "string"
    },
    "instagram": {
      "type": "string",
      "description": "Usuario de Instagram (sin @)"
    },
    "is_registered": {
      "type": "boolean",
      "default": true,
      "description": "true = cre\u00f3 cuenta; false = pedido express puntual"
    },
    "credit_limit": {
      "type": "number",
      "default": 0,
      "description": "L\u00edmite de cr\u00e9dito en USD base. 0 = sin l\u00edmite"
    },
    "category": {
      "type": "string",
      "description": "Origen del cliente, ej. Evento"
    },
    "event_status": {
      "type": "string",
      "enum": [
        "pendiente",
        "canjeado"
      ],
      "description": "Estado del helado de regalo del evento"
    },
    "event_registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_redeemed_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}