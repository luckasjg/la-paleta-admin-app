{
  "name": "Tray",
  "type": "object",
  "properties": {
    "recipe_id": {
      "type": "string",
      "description": "ID de la receta"
    },
    "recipe_name": {
      "type": "string",
      "description": "Nombre del sabor"
    },
    "produced_liters": {
      "type": "number",
      "description": "Litros producidos"
    },
    "remaining_grams": {
      "type": "number",
      "description": "Gramos restantes en la bandeja"
    },
    "initial_grams": {
      "type": "number",
      "description": "Gramos iniciales (acumulado si fue rellenada)"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "agotada"
      ],
      "description": "Estado de la bandeja"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de producci\u00f3n (se actualiza al rellenar)"
    },
    "first_production_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del primer lote de esta bandeja"
    },
    "refill_count": {
      "type": "number",
      "default": 0,
      "description": "Veces que esta bandeja fue completada con helado nuevo"
    },
    "last_refill_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del \u00faltimo relleno"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que la bandeja qued\u00f3 agotada"
    }
  },
  "required": [
    "recipe_name",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}