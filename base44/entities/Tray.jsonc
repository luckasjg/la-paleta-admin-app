{
  "name": "Tray",
  "type": "object",
  "properties": {
    "recipe_id": {
      "type": "string",
      "description": "ID de la receta"
    },
    "recipe_name": {
      "type": "string",
      "description": "Nombre del sabor"
    },
    "produced_liters": {
      "type": "number",
      "description": "Litros producidos"
    },
    "remaining_grams": {
      "type": "number",
      "description": "Gramos restantes en la bandeja"
    },
    "initial_grams": {
      "type": "number",
      "description": "Contenido real de la bandeja tras el \u00faltimo lote (restante anterior + helado nuevo)"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "agotada"
      ],
      "description": "Estado de la bandeja"
    },
    "in_vitrine": {
      "type": "boolean",
      "default": false,
      "description": "Si la bandeja est\u00e1 actualmente en vitrina vendi\u00e9ndose"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de producci\u00f3n (se actualiza al rellenar)"
    },
    "first_production_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del primer lote de esta bandeja"
    },
    "refill_count": {
      "type": "number",
      "default": 0,
      "description": "Veces que esta bandeja fue completada con helado nuevo"
    },
    "last_refill_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del \u00faltimo relleno"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que la bandeja qued\u00f3 agotada"
    },
    "real_cost_total": {
      "type": "number",
      "description": "Costo real de la materia prima del \u00faltimo lote producido"
    },
    "real_cost_per_gram": {
      "type": "number",
      "description": "Costo real por gramo del \u00faltimo lote"
    },
    "refill_log": {
      "type": "array",
      "description": "Historial de cada relleno aplicado a esta bandeja",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "grams_added": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          },
          "cost_per_gram": {
            "type": "number"
          },
          "remaining_before": {
            "type": "number"
          },
          "remaining_after": {
            "type": "number"
          },
          "substitutions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "original_supply_id": {
                  "type": "string"
                },
                "original_supply_name": {
                  "type": "string"
                },
                "substitute_supply_id": {
                  "type": "string"
                },
                "substitute_supply_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "saved_as_preferred": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "substitutions": {
      "type": "array",
      "description": "Sustituciones de insumos aplicadas al producir esta bandeja (hist\u00f3rico legado)",
      "items": {
        "type": "object",
        "properties": {
          "original_supply_id": {
            "type": "string"
          },
          "original_supply_name": {
            "type": "string"
          },
          "substitute_supply_id": {
            "type": "string"
          },
          "substitute_supply_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "saved_as_preferred": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "recipe_name",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}