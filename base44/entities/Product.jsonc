{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del producto en el POS"
    },
    "category": {
      "type": "string",
      "description": "Categor\u00eda del producto"
    },
    "size_label": {
      "type": "string",
      "description": "Etiqueta del tama\u00f1o (ej. Peque\u00f1a, Grande, Tina 1/2L)"
    },
    "flavor_count": {
      "type": "number",
      "description": "Cantidad de sabores que incluye este producto (1, 2 o 3). Solo para helados. (Legacy)",
      "default": 1
    },
    "requires_flavor": {
      "type": "boolean",
      "description": "Si es true, abre el selector de sabores al a\u00f1adir al carrito",
      "default": false
    },
    "max_flavors": {
      "type": "number",
      "description": "Cantidad m\u00e1xima de sabores permitidos cuando requires_flavor es true",
      "default": 1
    },
    "grams_per_serving": {
      "type": "number",
      "description": "Gramos totales que descuenta de las bandejas (se divide equitativamente entre sabores)"
    },
    "recipe_id": {
      "type": "string",
      "description": "Receta asociada (para caf\u00e9/merengadas)"
    },
    "utensil_supply_id": {
      "type": "string",
      "description": "(LEGACY) ID del insumo utensilio vinculado. Se mantiene por retrocompatibilidad; usar linked_supplies para nuevos productos."
    },
    "linked_supplies": {
      "type": "array",
      "description": "Lista de insumos/utensilios vinculados al producto. Cada uno se descuenta del inventario por venta.",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string",
            "description": "ID del insumo en inventario"
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad a descontar por unidad vendida (en la unidad base del insumo)"
          },
          "type": {
            "type": "string",
            "enum": [
              "materia_prima",
              "utensilio",
              "venta_directa"
            ],
            "description": "Tipo del insumo (snapshot del sector para mostrar en UI)"
          }
        }
      }
    },
    "price": {
      "type": "number",
      "description": "Precio de venta"
    },
    "image_url": {
      "type": "string",
      "description": "Imagen del producto"
    },
    "is_active": {
      "type": "boolean",
      "description": "Producto activo"
    },
    "sort_order": {
      "type": "number",
      "description": "Orden de visualizaci\u00f3n dentro de la categor\u00eda en el POS (menor = primero)",
      "default": 99
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}