{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del producto en el POS"
    },
    "category": {
      "type": "string",
      "description": "Categor\u00eda del producto"
    },
    "size_label": {
      "type": "string",
      "description": "Etiqueta del tama\u00f1o"
    },
    "flavor_count": {
      "type": "number",
      "default": 1
    },
    "requires_flavor": {
      "type": "boolean",
      "default": false
    },
    "max_flavors": {
      "type": "number",
      "default": 1
    },
    "grams_per_serving": {
      "type": "number"
    },
    "recipe_id": {
      "type": "string"
    },
    "utensil_supply_id": {
      "type": "string"
    },
    "linked_supplies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "materia_prima",
              "utensilio",
              "venta_directa"
            ]
          }
        }
      }
    },
    "vessel_optional": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, el POS pregunta al cajero si se sirve en taza (sin descontar utensilios) o vaso (descuenta utensilios)."
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "number",
      "default": 99
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}