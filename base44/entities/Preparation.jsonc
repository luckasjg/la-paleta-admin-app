{
  "name": "Preparation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "yield_amount": {
      "type": "number"
    },
    "yield_unit": {
      "type": "string",
      "enum": [
        "g",
        "ml"
      ],
      "default": "g"
    },
    "process_percentage": {
      "type": "number",
      "default": 0
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string"
          },
          "supply_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "linked_supply_id": {
      "type": "string"
    },
    "computed_cost_total": {
      "type": "number"
    },
    "computed_cost_per_unit": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "yield_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}