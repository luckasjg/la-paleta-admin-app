{
  "name": "Preparation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del preparado (ej. Pasta de Pistacho)"
    },
    "yield_amount": {
      "type": "number",
      "description": "Cantidad resultante en gramos o ml"
    },
    "yield_unit": {
      "type": "string",
      "enum": [
        "g",
        "ml"
      ],
      "default": "g",
      "description": "Unidad del rendimiento"
    },
    "process_percentage": {
      "type": "number",
      "description": "Porcentaje de recargo por proceso/merma (ej. 30 = 30%)",
      "default": 0
    },
    "ingredients": {
      "type": "array",
      "description": "Lista de insumos del preparado",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "type": "string"
          },
          "supply_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "linked_supply_id": {
      "type": "string",
      "description": "ID del insumo en inventario asociado a este preparado"
    },
    "computed_cost_total": {
      "type": "number",
      "description": "Costo total calculado (subtotal + proceso)"
    },
    "computed_cost_per_unit": {
      "type": "number",
      "description": "Costo por unidad (g o ml)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "yield_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}