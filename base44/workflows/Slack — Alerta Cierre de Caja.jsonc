{
  "name": "Slack \u2014 Alerta Cierre de Caja",
  "description": "Env\u00eda un resumen del cierre de caja al canal #caja en Slack del operador que lo cerr\u00f3.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"cerrada\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CashRegister"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_alerta_cierre_de_caja",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySlackCashClose",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifySlackCashClose"
  }
}