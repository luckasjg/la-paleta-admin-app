{
  "description": "Cuando un cajero escribe 'NNNN REFERENCIA' en #caja, marca la devoluci\u00f3n con ese c\u00f3digo de operaci\u00f3n como pagada, guarda la referencia y responde en el hilo.",
  "name": "Slack \u2014 Confirmar devoluci\u00f3n por texto",
  "trigger": {
    "condition": "${ .trigger.data.event.channel == \"C0B6G2TQEJJ\" and (.trigger.data.event.bot_id // \"\") == \"\" and ((.trigger.data.event.text // \"\") | test(\"^[0-9]{4} +[^ ]+\")) }",
    "config": {
      "trigger_type": "connector",
      "events": [
        "message.channels"
      ],
      "integration_type": "slackbot",
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_confirmar_devolucion_texto",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "confirmar_devolucion": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "confirmRefundByText",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Confirmar devoluci\u00f3n",
            "description": "Marca pagada y responde en el hilo"
          }
        }
      }
    ]
  }
}