{
  "name": "Alerta Slack de stock bajo (tiempo real)",
  "description": "Avisa a #general cuando un insumo cruza por debajo de su stock m\u00ednimo, y limpia la marca al reponerse.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"stock_current\") != null) or (.trigger.changed_fields | index(\"stock_minimum\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Supply"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerta_slack_de_stock_bajo_tiempo_real",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySlackLowStock",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifySlackLowStock"
  }
}