{
  "name": "Slack \u2014 Confirmar devoluci\u00f3n con mensaje",
  "description": "Cuando el operador escribe en #caja un mensaje con el c\u00f3digo de operaci\u00f3n y el n\u00b0 de referencia (ej. 'cod op: 0001 ref: 123456'), la app marca esa devoluci\u00f3n como pagada.",
  "trigger": {
    "condition": "${ .trigger.data.event.channel == \"C0B6G2TQEJJ\" and ((.trigger.data.event.text // \"\") | ascii_downcase | (test(\"op\") and test(\"ref\"))) }",
    "config": {
      "trigger_type": "connector",
      "integration_type": "slack",
      "events": [
        "message.channels"
      ],
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_confirmar_devolucion_mensaje",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "confirmar_devolucion": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "confirmRefundFromSlackMessage",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Marcar devoluci\u00f3n como pagada",
            "description": "Enlaza por c\u00f3digo de operaci\u00f3n"
          }
        }
      }
    ]
  }
}